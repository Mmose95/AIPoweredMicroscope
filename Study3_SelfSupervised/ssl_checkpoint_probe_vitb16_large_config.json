{
  "schema_version": 1,
  "experiment_name": "study3_vitb16_rfdetr_large_checkpoint_probe_40x",
  "arms": ["own_data_ssl"],
  "seeds": [0],
  "annotation_budgets": [1.0],
  "model": {
    "architecture": "dinov3_vitb16",
    "detector_variant": "large",
    "feature_layers": [2, 5, 8, 11],
    "resolution": 512,
    "patch_size": 16,
    "num_queries": 300,
    "freeze_encoder": true,
    "class_names": [
      "Leucocyte",
      "Squamous Epithelial Cell",
      "Columnar Epithelial Cell"
    ]
  },
  "training": {
    "epochs": 10,
    "batch_size": 2,
    "grad_accum_steps": 1,
    "lr": 0.0001,
    "weight_decay": 0.0007,
    "num_workers": 4,
    "checkpoint_interval": 10,
    "amp": true,
    "gradient_checkpointing": false
  },
  "selection": {
    "split": "valid",
    "metric": "val/ema_mAP_50_95",
    "test_during_training": false,
    "early_stopping": false
  },
  "probe": {
    "type": "frozen_backbone_detection_probe",
    "checkpoint_stride_ssl_epochs": 10,
    "include_first_checkpoint": true,
    "include_final_checkpoint": true,
    "primary_metric": "val/ema_mAP_50_95",
    "tie_break_metric": "val/ema_mAP_50"
  }
}
